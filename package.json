{
  "name": "vs-tessera",
  "displayName": "Tessera",
  "description": "One-click honest commits. Each commit is a tessera — a single tile in the mosaic of your work.",
  "version": "0.0.1",
  "publisher": "etkaturan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tessera",
          "title": "Tessera",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tessera": [
        {
          "id": "tessera.panel",
          "name": "Tessera",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tessera.commit",
        "title": "Tessera: Commit Now"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}